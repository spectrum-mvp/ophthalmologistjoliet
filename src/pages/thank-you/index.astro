---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | Spectrum Eye Institute"
  description="Thank you for contacting Spectrum Eye Institute."
  canonicalPath="/thank-you/"
  robots="noindex, nofollow"
>
  <main id="main" class="page">
    <div class="wrap">
      <article class="thanks">
        <h1>Thank you</h1>
        <p>Your message has been received. A member of our team will be in touch during office hours.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="https://s.odoro.com/mvp/?platform=spectrum" target="_blank" rel="noopener">Schedule Appointment</a>
          <a class="btn btn-outline btn-lg" href="tel:+18157293777">Call (815) 729-3777</a>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
