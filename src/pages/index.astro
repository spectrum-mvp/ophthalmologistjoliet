---
import BaseLayout from "../layouts/BaseLayout.astro";
import Locations from "../components/Locations.astro";
import locations from "../data/locations.json";

const title = "Spectrum Eye Institute | Eye Care in New Lenox & Joliet, IL";
const description =
  "Specialty eye care in New Lenox and Joliet, IL. Meet our doctors and learn about cataract surgery, LASIK, glaucoma, and more. Call (815) 729-3777.";
const homeServices = [
  { slug: "lasik", label: "LASIK vision correction" },
  { slug: "cataract-surgery", label: "Cataract surgery &amp; premium lenses" },
  { slug: "glaucoma", label: "Glaucoma treatment" },
  { slug: "diabetic-retinopathy", label: "Diabetic eye care" },
  { slug: "comprehensive-eye-care", label: "Comprehensive eye care" },
  { slug: "retina-conditions", label: "Retina conditions" },
];
const clinics = locations.map((location) => ({
  "@type": "MedicalClinic",
  name: `Spectrum Eye Institute – ${location.name}`,
  parentOrganization: { "@id": "https://www.ophthalmologistjoliet.com/#org" },
  telephone: location.tel,
  address: {
    "@type": "PostalAddress",
    streetAddress: location.street,
    addressLocality: location.cityStateZip.split(",")[0],
    addressRegion: "IL",
    postalCode: location.cityStateZip.match(/\d{5}/)?.[0],
    addressCountry: "US",
  },
}));
const organization = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalOrganization",
      "@id": "https://www.ophthalmologistjoliet.com/#org",
      name: "Spectrum Eye Institute",
      url: "https://www.ophthalmologistjoliet.com/",
      logo: "https://www.ophthalmologistjoliet.com/assets/spectrum-logo.png",
      telephone: "+18157293777",
      sameAs: ["https://www.facebook.com/spec.eye.institute"],
      parentOrganization: {
        "@type": "Organization",
        name: "Midwest Vision Partners",
        url: "https://midwestvision.com/",
      },
    },
    ...clinics,
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={[organization]}>
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <div class="eyebrow">Providers of Superior Ophthalmologic Care</div>
          <h1>Your Premier Destination for Specialized Eye Care</h1>
          <p class="lede">Combining cutting-edge techniques with compassionate care, Spectrum Eye Institute offers personalized vision solutions so you never miss a moment.</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href="https://s.odoro.com/mvp/?platform=spectrum" target="_blank" rel="noopener">Schedule Appointment</a>
            <a class="btn btn-outline btn-lg" href="tel:+18157293777">Call (815) 729-3777</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Quick contact">
          <div><div class="panel-label">Two offices</div><div class="panel-value">New Lenox &amp; Joliet</div></div>
          <div class="rule"></div>
          <div><div class="panel-label">Main phone line</div><a class="panel-phone" href="tel:+18157293777">(815) 729-3777</a></div>
          <div class="rule"></div>
          <a class="panel-link" href={`${import.meta.env.BASE_URL}doctors/`}>Meet Our Doctors &rarr;</a>
          <div class="rule"></div>
          <a class="panel-link" href="#locations">See Addresses &amp; Directions ↓</a>
        </aside>
      </div>
    </section>

    <section class="section" id="locations" aria-labelledby="locations-title">
      <div class="wrap">
        <div class="section-head">
          <div class="head-copy">
            <h2 id="locations-title">Our locations</h2>
            <p class="section-note">Hours vary by office &mdash; please call before your visit to confirm.</p>
          </div>
        </div>
        <Locations />
      </div>
    </section>

    <section class="section services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="services-intro">
          <h2 id="services-title">What we treat</h2>
          <p>Subspecialty eye care for patients across Cook, Will, Grundy, Kendall and Kankakee Counties.</p>
        </div>
        <ul class="service-list">
          {homeServices.map((service) => (
            <li><a href={`${import.meta.env.BASE_URL}${service.slug}/`} set:html={service.label} /></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
