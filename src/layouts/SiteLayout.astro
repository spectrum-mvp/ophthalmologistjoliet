---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  viewportFit?: boolean;
}

const { title, viewportFit = false } = Astro.props;
const viewport = viewportFit
  ? 'width=device-width,initial-scale=1,viewport-fit=cover'
  : 'width=device-width,initial-scale=1';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KL553QLN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content={viewport} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@500;600&amp;family=Source+Sans+3:wght@400;600;700&amp;display=swap" />
    <link rel="stylesheet" href={withBase('styles/global.css')} />
    <slot name="head" />
    <script is:inline defer src={withBase('scripts/site.js')}></script>
    <script is:inline defer src={withBase('scripts/navigation.js')}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <div class="band" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <slot />
    <Footer />
  </body>
</html>
