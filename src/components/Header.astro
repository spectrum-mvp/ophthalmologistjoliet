---
import AppointmentLink from './AppointmentLink.astro';
import { withBase } from '../lib/paths';

const isCurrent = (route: string) => Astro.url.pathname === withBase(route);
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href={withBase("")} aria-current={isCurrent("") ? 'page' : undefined}><img src={withBase("assets/spectrum-logo.png")} alt="Spectrum Eye Institute home" width="1000" height="470"></a>
    <nav class="site-nav" aria-label="Main">
      <div class="nav-item has-menu">
        <button type="button" class="nav-link nav-toggle" aria-expanded="false" aria-controls="services-menu">Services<svg class="nav-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 9l7 7 7-7"/></svg></button>
        <ul class="nav-menu" id="services-menu" hidden>
          <li><a href={withBase("cataract-surgery/")} aria-current={isCurrent("cataract-surgery/") ? 'page' : undefined}>Cataract Surgery</a></li>
          <li><a href={withBase("lasik/")} aria-current={isCurrent("lasik/") ? 'page' : undefined}>LASIK</a></li>
          <li><a href={withBase("glaucoma/")} aria-current={isCurrent("glaucoma/") ? 'page' : undefined}>Glaucoma</a></li>
          <li><a href={withBase("diabetic-retinopathy/")} aria-current={isCurrent("diabetic-retinopathy/") ? 'page' : undefined}>Diabetic Retinopathy</a></li>
          <li><a href={withBase("corneal-transplant/")} aria-current={isCurrent("corneal-transplant/") ? 'page' : undefined}>Corneal Transplant</a></li>
          <li><a href={withBase("comprehensive-eye-care/")} aria-current={isCurrent("comprehensive-eye-care/") ? 'page' : undefined}>Comprehensive Eye Care</a></li>
          <li><a href={withBase("cosmetic-injectables/")} aria-current={isCurrent("cosmetic-injectables/") ? 'page' : undefined}>Cosmetic Injectables</a></li>
        </ul>
      </div>
      <a class="nav-link" href={withBase("our-doctors/")} aria-current={isCurrent("our-doctors/") ? 'page' : undefined}>Our Doctors</a>
      <a class="nav-link" href={withBase("contact/")} aria-current={isCurrent("contact/") ? 'page' : undefined}>Contact</a>
    </nav>
    <div class="header-actions">
      <a class="header-phone" href="tel:+18157293777" aria-label="Call Spectrum Eye Institute at (815) 729-3777"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span class="full">(815) 729-3777</span><span class="short">Call</span></a>
      <AppointmentLink class="btn btn-primary">Schedule Appointment</AppointmentLink>
    </div>
  </div>
</header>
